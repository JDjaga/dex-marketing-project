# ==============================================================================
# DEX Marketing by Colakin — Environment Configuration
# ==============================================================================
# The application boots cleanly in full Demo Mode without external keys.
# Configure any variables below to enable live database, AI, email, or CRM connections.

# Application URL (injected automatically in AI Studio runtime)
APP_URL="MY_APP_URL"

# Neon PostgreSQL Database Connection (Optional — defaults to Parity Demo Store if unset)
DATABASE_URL=

# Session Signing Secret (falls back to secure runtime ephemeral secret if unset)
AUTH_SECRET=

# AI Providers (Server-side only — never exposed to browser)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=

# Email Infrastructure (mock | smtp | resend)
EMAIL_PROVIDER=mock
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS="campaigns@dex-marketing.local"

# File Storage (local | cloudinary | s3)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CRM / MCP Connectors (Optional — simulated MCP CRM server works out of the box)
MCP_CRM_ENDPOINT=
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# LinkedIn OAuth (optional — enables real LinkedIn publishing)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match the redirect URL registered in your LinkedIn app.
# Defaults to {APP_URL}/api/social/linkedin/callback when unset.
LINKEDIN_REDIRECT_URI=
